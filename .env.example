# ==============================================================================
# MEXAGENDA — VARIABLES DE ENTORNO DE REFERENCIA (.env.example)
# ==============================================================================
# Este archivo contiene la plantilla documentada de variables requeridas para
# ejecutar el sistema. NUNCA introduzca credenciales reales ni suba archivos
# .env al repositorio de Git.
# ==============================================================================

# Entorno de ejecución: 'development' | 'staging' | 'production' | 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# PUERTOS Y URLs DE COMUNICACIÓN
# ------------------------------------------------------------------------------
# Puerto local en el que escucha el backend NestJS
PORT=4000

# URL pública o local del Frontend (utilizada para políticas CORS del backend)
FRONTEND_URL=http://localhost:3000

# URL pública o local del Backend API
BACKEND_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# NEON POSTGRESQL & PRISMA ORM
# ------------------------------------------------------------------------------
# Cadena de conexión transaccional (Pooled) a través de PgBouncer en Neon.
# Se utiliza para la operación ordinaria del backend en runtime.
# Formato: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://placeholder_user:placeholder_pass@ep-cool-pool-123456-pooler.us-east-2.aws.neon.tech/mexagenda_db?sslmode=require"

# Cadena de conexión directa (Unpooled) a Neon PostgreSQL (puerto 5432).
# Se utiliza exclusivamente por Prisma Migrate para crear tablas e índices
# sin interferencia de las restricciones de sesión de PgBouncer.
# Formato: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://placeholder_user:placeholder_pass@ep-cool-pool-123456.us-east-2.aws.neon.tech/mexagenda_db?sslmode=require"

# ------------------------------------------------------------------------------
# SEGURIDAD CRIPTOGRÁFICA Y AUTENTICACIÓN (FASE 2)
# ------------------------------------------------------------------------------
# Clave simétrica de 256 bits (64 caracteres hexadecimales) para cifrado AES-256-GCM
# de secretos TOTP en la tabla user_mfa.
MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secreto para firma o derivación de sesiones seguras
SESSION_SECRET="placeholder_session_secret_change_in_production"

# Credenciales iniciales para script de bootstrap de Administrador institucional
ADMIN_INITIAL_EMAIL="admin@institucion.gob.mx"
ADMIN_INITIAL_PASSWORD="ChangeMe#2026!MexAgenda"
ADMIN_INITIAL_NAME="Administrador Institucional"

# ------------------------------------------------------------------------------
# BÓVEDA DOCUMENTAL COMPATIBLE CON S3 (PREPARACIÓN FASE 6)
# ------------------------------------------------------------------------------
S3_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="mexagenda-vault"
S3_ACCESS_KEY_ID="placeholder_access_key"
S3_SECRET_ACCESS_KEY="placeholder_secret_key"
# Modo de cifrado en reposo en S3: "AES256" (SSE-S3), "aws:kms" (SSE-KMS) o "NONE"
S3_SSE_MODE="AES256"
# ARN o ID de llave KMS (obligatorio cuando S3_SSE_MODE="aws:kms" con CMK propia)
S3_KMS_KEY_ID=""

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO SMTP Y NOTIFICACIONES (FASE 7)
# ------------------------------------------------------------------------------
# Si SMTP_HOST no está definido, el sistema conmuta automáticamente a Mock/JsonTransport
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="placeholder_smtp_user"
SMTP_PASSWORD="placeholder_smtp_password"
SMTP_FROM_NAME="MexAgenda Institucional"
SMTP_FROM_EMAIL="notificaciones@institucion.gob.mx"

# Configuración de Colas y Procesamiento Asíncrono (BullMQ / Redis)
# Si REDIS_HOST no está definido, el sistema utiliza el OutboxQueueDriver transaccional en PostgreSQL
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# FRONTEND NEXT.JS (APLICACIÓN WEB / VERCEL)
# ------------------------------------------------------------------------------
# Variables expuestas al cliente web en el navegador (prefijo NEXT_PUBLIC_)
# URL base pública del backend NestJS
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# URL pública de los endpoints versionados de la API
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"


